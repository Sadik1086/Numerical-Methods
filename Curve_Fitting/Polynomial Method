//y=a_0+a_1x+a_2x^2
#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    int n, degree;
    cin >> n >> degree;

    int m = degree + 1;

    double x[100], y[100];

    for(int i = 0; i < n; i++)
        cin >> x[i] >> y[i];

    double A[10][11] = {0};

    // Normal equation
    for(int i = 0; i < m; i++)
    {
        for(int j = 0; j < m; j++)
        {
            for(int k = 0; k < n; k++)
                A[i][j] += pow(x[k], i + j);
        }

        for(int k = 0; k < n; k++)
            A[i][m] += pow(x[k], i) * y[k];
    }

    // Gaussian Elimination
    for(int i = 0; i < m; i++)
    {
        for(int j = i + 1; j < m; j++)
        {
            double factor = A[j][i] / A[i][i];

            for(int k = i; k <= m; k++)
                A[j][k] -= factor * A[i][k];
        }
    }

    // Back Substitution
    double a[10];

    for(int i = m - 1; i >= 0; i--)
    {
        double sum = 0;

        for(int j = i + 1; j < m; j++)
            sum += A[i][j] * a[j];

        a[i] = (A[i][m] - sum) / A[i][i];
    }

    cout << "f(x) = ";

    for(int i = 0; i < m; i++)
    {
        cout << a[i];

        if(i == 1)
            cout << "x";
        else if(i > 1)
            cout << "x^" << i;

        if(i != m - 1)
            cout << " + ";
    }

    cout << endl;

    double xNew;
    cin >> xNew;

    double result = 0;

    for(int i = 0; i < m; i++)
        result += a[i] * pow(xNew, i);

    cout << "f(" << xNew << ") = " << result << endl;

    return 0;
}
